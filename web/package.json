{
  "name": "crew-juggle-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "icons": "node scripts/icons.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/pwa.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,css,html,json,svg,webmanifest}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,css,html,json,svg,webmanifest}\""
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.103.2",
    "firebase": "^12.4.0",
    "lucide-react": "^1.47.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^29.1.1",
    "prettier": "3.9.10",
    "typescript": "^5.9.3",
    "vite": "^8.0.1",
    "vitest": "^4.1.11"
  }
}
