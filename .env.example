# Copy to .env for `cargo run -p juggle-server -- --config config/demo.yaml`.
# Docker compose does not need it.

DATABASE_URL=postgres://juggle:juggle@localhost:5432/juggle

# `--config config/demo.yaml` is the local sandbox: character sign-in, demo data
# resets on restart, no Firebase needed. config/production.yaml (the default)
# signs in with Google and needs the Firebase settings below.
JUGGLE_DEMO_TIMEZONE=Europe/Berlin

# FIREBASE_PROJECT_ID=your-firebase-project
# JUGGLE_ALLOWED_EMAILS=you@example.com,friend@example.com

# Web Push identity; without it, a throwaway identity is used until restart.
# Generate once: npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Real receipt scanning instead of the demo scanner.
OPENAI_API_KEY=
OPENAI_MODEL=
