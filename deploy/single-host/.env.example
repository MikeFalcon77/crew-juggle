# Copy to .env next to compose.yaml and fill in.
DOMAIN=juggle.example.com
POSTGRES_PASSWORD=change-me-to-something-long

# Firebase project with Google sign-in enabled (Authentication → Sign-in method).
FIREBASE_PROJECT_ID=your-firebase-project
VITE_FIREBASE_API_KEY=your-public-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project.firebaseapp.com
# Optional: only these addresses may sign in (comma separated).
JUGGLE_ALLOWED_EMAILS=

# Web Push identity. Generate once and keep it: `npx web-push generate-vapid-keys`
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Optional: real receipt scanning (a vision model with structured outputs).
OPENAI_API_KEY=
OPENAI_MODEL=
